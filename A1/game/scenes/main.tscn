[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "BLACKWELL: LAST SHIFT"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "M0 infrastructure baseline\nGameplay begins in M1."
horizontal_alignment = 1

[node name="Quit" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Quit"

[connection signal="pressed" from="Center/Content/Quit" to="." method="_on_quit_pressed"]
